# ---- Server ----
PORT=8080
# Comma-separated allow-list of browser Origins for local CORS. Unset echoes any
# origin (fine for local dev; a gateway supplies CORS in production).
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated caller API keys (X-API-Key). Leave empty to DISABLE auth
# (local dev). In production, prefer a gateway/JWT in front of this service.
# CALLER_API_KEYS=internal-signup-key,internal-dashboard-key

# ---- Classification model ----
# Set false to run the deterministic cascade only (no key needed); unknown
# reachable domains then resolve to "unknown".
LLM_ENABLED=true
# Required when LLM_ENABLED=true.
ANTHROPIC_API_KEY=sk-ant.....
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=8s

# ---- Behaviour ----
CACHE_TTL=48h
MX_TIMEOUT=3s

# ---- Disposable list ----
# Loaded at startup, then auto-refreshed from DISPOSABLE_LIST_URL every
# DISPOSABLE_REFRESH_INTERVAL and written back to DISPOSABLE_LIST_PATH.
# Set the interval to 0 to disable background polling.
DISPOSABLE_LIST_PATH=./data/disposable_domains.txt
DISPOSABLE_LIST_URL=https://dmails.doodadlabs.org/data/domains.txt
DISPOSABLE_REFRESH_INTERVAL=2h
# FREE_PROVIDER_LIST_PATH=
